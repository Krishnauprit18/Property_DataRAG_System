[req]
default_bits = 2048
prompt = no
default_md = sha256
distinguished_name = dn
req_extensions = req_ext

[dn]
C = IN
ST = MP
L = Local
O = PropertyRAG
CN = property-rag.local

[req_ext]
subjectAltName = @alt_names

[alt_names]
DNS.1 = property-rag.local
DNS.2 = *.property-rag.local
DNS.3 = api.property-rag.local
DNS.4 = frontend.property-rag.local
DNS.5 = argocd.property-rag.local
